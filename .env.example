# =============================================================================
# .env.example — every environment variable this project reads, no real values.
# Copy to .env and fill in; .env is gitignored and never committed.
# The server validates all of these at startup and exits with the name of the
# first bad one, rather than failing at the first tool call.
# =============================================================================

# --- Required ----------------------------------------------------------------

# The hub's address on your local network. Must be private: a public address is
# refused, because the Maker API sends its token in cleartext.
# Find it at Settings > Hub Details on the hub.
HUBITAT_HOST=192.168.1.50

# The Maker API installed-app id, digits only. It is the number in the Maker
# API app's own URL: .../installedapp/configure/<this number>/
HUBITAT_MAKER_APP_ID=42

# The Maker API access token, shown in the Maker API app's settings page.
# SECURITY: this is full control of every device the app exposes — treat it
# like a password. Rotate it from the app if it is ever exposed.
HUBITAT_MAKER_TOKEN=00000000-0000-0000-0000-000000000000

# --- Optional ----------------------------------------------------------------

# The hub's HTTP port. Leave unset unless the hub sits behind a local proxy.
# HUBITAT_PORT=80

# Per-request connect and read timeout, 1-60 seconds.
# HUBITAT_TIMEOUT_SECONDS=10

# Allows commands to locks, doors, garage doors, valves, security keypads, and
# alarms, and allows hub mode changes. Off unless set to exactly true.
# SECURITY: turning this on means a prompt injection hidden in a device name
# could persuade Claude to unlock a door. Leave it off unless you want that
# capability, and rely on your MCP client's approval prompt when you do.
# HUBITAT_ALLOW_SECURITY_COMMANDS=false

# Restricts commands to these device ids, comma-separated. Unset means every
# device that passes the guarded-device checks.
# SECURITY: set this if any door, gate, or garage opener on your hub is wired
# as a plain switch. Such a device declares no lock or door capability, so the
# capability check cannot recognize it, and a command like `on` would open it.
# It also binds rule creation: a rule naming a device outside this list is
# refused, so the list covers the unattended write path too.
# HUBITAT_WRITABLE_DEVICE_IDS=154,200

# --- The rules app (optional) -------------------------------------------------

# Set both of these to turn on the rule tools, which let Claude create
# automations that run on the hub. Leave both unset and the rest of the server
# works exactly as before; setting one without the other is refused at startup.
# Both come from the Claude Automations app's own page on the hub.
#
# SECURITY: this token is a second full-weight credential — it grants rule
# authorship over the device pool you selected in that app. A rule runs
# unattended, with no approval prompt, so treat this like the Maker API token.
# HUBITAT_AUTOMATIONS_APP_ID=77
# HUBITAT_AUTOMATIONS_TOKEN=00000000-0000-0000-0000-000000000000
